# Copy this file to .env.local and fill in whichever keys you have.
# Every one of these is optional — with none set, Portfolio AI runs entirely
# on its deterministic mock AI layer (lib/ai/mock-*.ts), so the full
# upload -> generate -> edit flow works with zero configuration.

# Powers real resume extraction (lib/ai/resume-extraction.ts) and
# inspiration-image analysis (lib/ai/style-extraction.ts) via Groq's
# OpenAI-compatible API. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Raises GitHub's unauthenticated rate limit (60 req/hr -> 5,000 req/hr) for
# the GitHub-import path (lib/ai/github-import.ts) and unlocks fetching a
# user's actual pinned repos via GraphQL. A fine-grained personal access
# token with no scopes (public data only) is enough.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# NOTE: lib/ai/openai-client.ts exists but is not currently called from
# anywhere — Groq is the only wired AI provider today. Leave this unset
# unless/until that changes.
# OPENAI_API_KEY=

# REQUIRED for persistence (dashboard, saving, autosave). A Postgres
# connection string. For local development, run Postgres yourself (or via
# Docker: `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16`)
# and point this at it. For production, any hosted Postgres works (Neon,
# Supabase, Railway, RDS, etc.) — just paste their connection string here.
# After setting this, run `npm run db:push` once to create the tables.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_ai

# REQUIRED. Authentication (login/signup/sessions) is powered by Better Auth
# (lib/auth/auth.ts). BETTER_AUTH_SECRET signs session tokens — generate a
# real one for any shared/deployed environment with:
#   openssl rand -base64 32
# A throwaway value is fine for pure local development, but never reuse one
# across environments and never commit a real value.
BETTER_AUTH_SECRET=

# The app's own base URL. Required so Better Auth builds correct callback/
# redirect URLs. Same value, once for the server and once exposed to the
# browser (Next.js only exposes NEXT_PUBLIC_* vars client-side).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
